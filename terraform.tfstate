            "outpost_arn": null,
            "password_data": "",
            "placement_group": null,
            "placement_group_id": null,
            "placement_partition_number": null,
            "primary_network_interface": [
              {
                "delete_on_termination": true,
                "network_interface_id": "eni-0b4f56d8d2d300f92"
              }
            ],
            "primary_network_interface_id": "eni-0b4f56d8d2d300f92",
            "private_dns": "ip-10-0-1-161.ap-southeast-1.compute.internal",
            "private_dns_name_options": null,
            "private_ip": "10.0.1.161",
            "public_dns": "",
            "public_ip": "18.143.101.78",
            "region": "ap-southeast-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/sda1",
                "encrypted": false,
                "iops": 360,
                "kms_key_id": "",
